{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asof.pro/schema/asof-passport-0.1.json",
  "title": "AsOf Passport v0.1",
  "description": "What stands behind a token as of a given date. Every fact cites its source. Licensed CC BY 4.0.",
  "type": "object",
  "required": ["schema", "id", "name", "type", "as_of", "issuer", "deployments", "facts", "unknowns", "measurements", "sources", "counts"],
  "properties": {
    "schema": {"const": "asof-passport/0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string"},
    "ticker": {"type": "string"},
    "type": {"enum": ["rwa", "stablecoin", "coin"]},
    "category": {"type": "string"},
    "as_of": {"type": "string", "format": "date-time", "description": "Time of the last successful pipeline run for this asset."},
    "archived_since": {"type": ["string", "null"], "description": "When AsOf first archived a document of this token. Nothing before this moment is in the archive."},
    "issuer": {
      "type": ["object", "null"],
      "required": ["name"],
      "properties": {"name": {"type": "string"}, "jurisdiction": {"type": "string"}}
    },
    "deployments": {"type": "array", "items": {"$ref": "#/$defs/deployment"}},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "unknowns": {
      "type": "array",
      "items": {"type": "object", "required": ["field", "layer"], "properties": {"field": {"type": "string"}, "layer": {"$ref": "#/$defs/layer"}}}
    },
    "measurements": {"type": "array", "items": {"$ref": "#/$defs/measurement"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "control_history": {
      "type": "object",
      "description": "Changes in who controls the contract (roles, proxy code, multisig thresholds, timelock delays), found by comparing AsOf's daily on-chain readings. Covers only the time since observed_since.",
      "properties": {
        "observed_since": {"type": ["string", "null"]},
        "changes": {"type": "array", "items": {"type": "object", "required": ["key", "from", "to", "last_seen_before", "first_seen_after"]}}
      }
    },
    "reserve_check": {"type": "object", "description": "Promise vs reserve reports: the promised reporting frequency (an approved fact), archived reports with quoted figures and dates, the on-chain supply, and neutral notes on differences in dates or figures. Not an assessment."},
    "counts": {
      "type": "object",
      "required": ["confirmed", "claimed", "unknown"],
      "properties": {"confirmed": {"type": "integer"}, "claimed": {"type": "integer"}, "unknown": {"type": "integer"}}
    }
  },
  "$defs": {
    "layer": {"enum": ["summary", "legal", "exit", "backing", "rules", "mica"]},
    "deployment": {
      "type": "object",
      "required": ["chain", "chain_id", "address", "address_source"],
      "properties": {
        "chain": {"type": "string"},
        "chain_id": {"type": "integer"},
        "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
        "decimals": {"type": "integer"},
        "address_source": {"type": "string", "format": "uri"},
        "onchain_check": {"type": "object"}
      }
    },
    "fact": {
      "type": "object",
      "required": ["id", "layer", "field", "text", "quote", "source_id", "source_url", "source_owner", "evidence", "approved_at"],
      "properties": {
        "id": {"type": "string"},
        "layer": {"$ref": "#/$defs/layer"},
        "field": {"type": "string"},
        "text": {"type": "string", "description": "Plain-language statement in English, approved by the editor."},
        "translations": {"type": "object", "additionalProperties": {"type": "string"}, "description": "The text in other UI languages. The quote is never translated."},
        "translated_by": {"type": "string", "description": "Who produced the translations (e.g. deepl, claude); marks them as machine translation."},
        "translated_from": {"type": "string", "description": "The English text the translations were made from."},
        "quote": {"type": "string", "maxLength": 600, "description": "Verbatim words from the source, in the source language."},
        "section": {"type": "string"},
        "source_id": {"type": "string"},
        "source_url": {"type": "string", "format": "uri"},
        "source_owner": {"type": "string"},
        "snapshot_sha256": {"type": "string"},
        "published_at": {"type": "string"},
        "fetched_at": {"type": "string"},
        "approved_at": {"type": "string"},
        "evidence": {"enum": ["confirmed", "claimed"]}
      }
    },
    "measurement": {
      "type": "object",
      "required": ["key", "value", "read_at", "source"],
      "properties": {
        "key": {"type": "string"},
        "value": {"type": ["string", "boolean", "null"]},
        "unit": {"type": "string"},
        "chain_id": {"type": "integer"},
        "block": {"type": "integer"},
        "read_at": {"type": "string"},
        "published_at": {"type": "string"},
        "source": {"type": "string"},
        "error": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "kind", "url", "owner"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "owner": {"type": "string"},
        "last_checked_at": {"type": ["string", "null"]},
        "last_status": {"type": ["string", "null"]},
        "last_changed_at": {"type": ["string", "null"]},
        "sha256_text": {"type": ["string", "null"]},
        "versions": {"type": "integer"},
        "first_archived_at": {"type": ["string", "null"], "description": "First successful snapshot of this source: the archive covers it from this moment on."},
        "last_ok_at": {"type": ["string", "null"]},
        "history": {
          "type": "array",
          "description": "Every archived version, newest first: first and last seen by AsOf, SHA-256 of the extracted text and of the file, and a link to the nearest Internet Archive copy. AsOf publishes no copies of documents itself.",
          "items": {
            "type": "object",
            "required": ["sha256_text", "first_seen", "last_seen"],
            "properties": {
              "sha256_text": {"type": "string"}, "sha256_raw": {"type": "string"}, "size": {"type": "integer"},
              "format": {"type": "string"}, "first_seen": {"type": "string"}, "last_seen": {"type": "string"},
              "wayback": {"type": "string", "format": "uri"}
            }
          }
        },
        "timestamp_token": {"type": ["string", "null"], "description": "Path of the latest daily proof (RFC 3161 time-stamps with LTV data) whose manifest lists this exact version of the document, e.g. /data/proofs/2026-10-24/proof.json; null if none yet."}
      }
    }
  }
}
